{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ComfyUI-Installer",
  "version": "1.0.0",
  "identifier": "app.comfyui.installer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ComfyUI安装助手",
        "width": 1280,
        "height": 860,
        "minWidth": 1180,
        "minHeight": 820,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: https://asset.localhost; connect-src 'self' http://127.0.0.1:* http://localhost:* ws://127.0.0.1:* ws://localhost:* ipc: http://ipc.localhost https:; img-src 'self' data: asset: https://asset.localhost http: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; frame-src http://127.0.0.1:* http://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "createUpdaterArtifacts": "v1Compatible"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM0MUMxRDUwQTQxQjc2RDMKUldUVGRodWtVQjBjTklXOHJPeWpyWWtmRzJIY3VLR3lDMG1OcDdqQUZWZ3Z2NjEvVllqOHEvMkoK",
      "endpoints": [
        "https://github.com/zhirai-tech/comfyui-installer/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
